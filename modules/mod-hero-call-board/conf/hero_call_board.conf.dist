###################################################################################################
#  mod-hero-call-board
#
#  英雄的召唤板（暴风城）与酋长的命令板（奥格瑞玛）：
#  Ascension 客户端的召唤板窗口，包含其PvE、专业和 PvP 日常类别。
#  接受、交付或放弃召唤板任务时，已打开的类别会保持在屏幕上，
#  因此“全部接受”和批量交付都能正常工作。该模块还会为需要服务器事件的日常任务计入进度：
#  决斗胜利、战场胜利以及按难度划分的地下城查找器通关。
#
#  此代码是 AzerothCore 项目的一部分。版权信息请参见 AUTHORS 文件。
###################################################################################################

[worldserver]

#    HeroCallBoard.Enable
#        Description: 召唤板是否响应其类别并为日常任务计入进度。
#        Default:     1 - (Enabled)
#                     0 - (Disabled; 召唤板表现为普通任务给予者)
HeroCallBoard.Enable = 1

#    HeroCallBoard.AutoOffer
#        Description: 达到某一等级时是否将解锁的英雄的召唤或酋长的命令区域命令
#                     作为“发现任务！”弹出提示提供给玩家，玩家可在任意位置接受。
#                     再次登录不会提供任何内容；已忽略的命令仍可从公告板获取。
#        Default:     1 - (Enabled)
#                     0 - (Disabled; 命令仅从公告板获取)
HeroCallBoard.AutoOffer = 1
